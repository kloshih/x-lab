# surreal start — "secure" instance on jia: tailnet-reachable, root
# user/pass required. SURREAL_PASS comes from the git-ignored secret.env,
# which run.sh generates on first start.
# (SURREAL_PATH is set by run.sh — env files don't expand $HOME.)
SURREAL_BIND=100.80.150.96:8001
SURREAL_USER=root
SURREAL_LOG=info
